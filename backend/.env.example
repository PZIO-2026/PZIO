# Backend configuration. Copy to `.env` and fill in real values for non-default
# settings. Never commit the real `.env` file.

# Database
# Local default uses SQLite. Production target is PostgreSQL (CON4 in the SRS):
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/pzio
# In `docker compose up` the backend talks to the `db` service:
#   DATABASE_URL=postgresql+psycopg://pzio:pzio@db:5432/pzio
DATABASE_URL=sqlite:///./pzio.db

# JWT
# JWT_SECRET MUST be overridden in production with a long random value.
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=60

# CORS — comma-separated list of allowed origins (frontend dev server, etc.).
CORS_ORIGINS=http://localhost:5173

# Base URL of the frontend. Used when composing user-facing links (e.g. the
# password-reset email). Must match the dev server / deployed origin.
FRONTEND_URL=http://localhost:5173

# Directory for forced DB backups (SAD §4.5 — POST /api/admin/backups).
BACKUP_DIR=./backups
# Directory for uploaded task attachments.
UPLOAD_DIR=./uploads
# Maximum allowed file size for uploads (in bytes). Default is 10 MiB.
MAX_FILE_SIZE=10485760

# OAuth 2.0 Providers (get these from your Google/GitHub developer consoles)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
