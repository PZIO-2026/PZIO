# Frontend configuration. Copy to `.env` to override defaults locally.

# Base URL of the PZIO backend API. The default points at the local
# development server (see `backend/README.md`).
VITE_API_BASE_URL=http://localhost:8000

# OAuth Configuration (Google and GitHub Client IDs)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GITHUB_CLIENT_ID=your_github_client_id_here