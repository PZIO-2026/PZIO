# Docker Compose environment file. Copy to `.env` (which is git-ignored) and
# adjust the values for your environment. `docker compose up` reads this file
# automatically from the repository root.
#
# JWT_SECRET is **required** — the backend refuses to start without it so we
# never ship the dev value to production. For local development the value
# below is fine; for production override it with a long, random secret.
JWT_SECRET=dev-secret-change-me-in-production

# OAuth login (Google / GitHub) — optional. Leave a variable unset (or empty)
# to disable that provider; the frontend then hides its button. See
# `docs/user-guide-pl.md` § "Konfiguracja logowania przez Google / GitHub"
# for the registration steps.
#
# The frontend `VITE_*_CLIENT_ID` values are inlined into the JS bundle at
# build time, so changing them requires `docker compose up --build` (a plain
# restart will reuse the previous bundle).
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#VITE_GOOGLE_CLIENT_ID=
#VITE_GITHUB_CLIENT_ID=
